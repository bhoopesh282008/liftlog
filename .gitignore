# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Public build settings only: the Supabase URL and publishable key ship in
# the client bundle anyway. Secrets never go here.
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify knowledge graph output
/graphify-out/

# playwright-cli session files
/.playwright-cli/

# python caches (UI/UX Pro Max skill scripts)
__pycache__/

# Other coding agents' copies of the Motion AI kit (not used in this repo)
/.agents/
/.amp/
/.codex/
/.copilot/
/.cursor/
/.gemini/
/.opencode/
/.tracker/
/opencode.jsonc
